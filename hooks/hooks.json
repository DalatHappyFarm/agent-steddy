{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard_bash.py\"", "timeout": 5 },
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/tool_timing.py\" pre", "timeout": 5 }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard_agent.py\"", "timeout": 5 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/guard_write.py\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/secret_output_scan.py\"", "timeout": 5 },
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/tool_timing.py\" post", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/secret_output_scan.py\"", "timeout": 5 },
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/tool_timing.py\" fail", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/gate_reminder.py\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_check.py\"", "timeout": 5 }
        ]
      }
    ]
  }
}
