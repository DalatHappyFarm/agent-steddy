{
  "workingBranch": "main",
  "verifyCommand": "make verify",
  "agents": {
    "allowed": ["acme-*"],
    "models": {
      "acme-web": "sonnet",
      "acme-docs": "haiku",
      "acme-auditor": "sonnet"
    },
    "writeFences": {
      "acme-auditor": ["docs/reviews/"]
    }
  },
  "guards": {
    "disable": []
  },
  "handback": {
    "agents": ["acme-*"],
    "required": [
      { "id": "verification", "pattern": "(?i:verif)|\\bL[0-5]\\b", "hint": "the verification level used" },
      { "id": "retro", "pattern": "(?i:retro)", "hint": "a one line retro (worked / exposed / rule)" },
      { "id": "resources", "pattern": "(?i:resource|released|kept)", "hint": "a resources line (released or kept, and why)" }
    ]
  },
  "commands": {
    "deny": [
      { "match": "supabase config push", "reason": "A config push overwrites the settings of the live project. Ask the owner to run it." }
    ],
    "askFromSubagent": ["git push", "make deploy", "make deploy-web"],
    "alwaysAsk": ["npm publish", "pnpm publish"]
  },
  "reminder": {
    "enabled": true,
    "text": "Pass the seven gates for this request, record decisions with `agent-steddy record decision`, and commit only when asked."
  },
  "records": {
    "lessons": "docs/agents/lessons.md",
    "metrics": "docs/agents/metrics.jsonl",
    "decisions": "docs/agents/decisions.md"
  }
}
